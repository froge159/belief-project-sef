        "\n",
        "        # Prefer absolute position_ids when available (important during cached decoding).\n",
        "        position_ids = module_kwargs.get(\"position_ids\", None)\n",
        "        if isinstance(position_ids, torch.Tensor) and position_ids.shape == token_positions.shape:\n",
