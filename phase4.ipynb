    {
      "cell_type": "code",
      "source": [
        "  import os\n",
        "\n",
        "  def generate_pair_and_print(\n",
        "      model,\n",
        "      tokenizer,\n",
        "      input_text,\n",
        "      direction,\n",
        "      alpha,\n",
        "      layer_index,\n",
        "      instruction_len,\n",
        "      row_id=None,\n",
        "      max_new_tokens=500,\n",
        "      temperature=0,\n",
        "      do_sample=True,\n",
        "  ):\n",
        "      prompt_cache = prepare_prompt_cache(model, tokenizer, input_text)\n",
        "\n",
        "      baseline = decode_from_prompt_cache(\n",
        "          model,\n",
        "          tokenizer,\n",
        "          prompt_cache,\n",
        "          max_new_tokens=max_new_tokens,\n",
        "          temperature=temperature,\n",
        "          do_sample=do_sample,\n",
        "      )\n",
        "\n",
        "      steered = generate_with_steering_from_cache(\n",
        "          model,\n",
        "          tokenizer,\n",
        "          prompt_cache,\n",
        "          direction,\n",
        "          alpha,\n",
        "          layer_index,\n",
        "          instruction_len,\n",
        "          max_new_tokens=max_new_tokens,\n",
        "          temperature=temperature,\n",
        "          do_sample=do_sample,\n",
        "      )\n",
        "\n",
        "      print(f\"--- Baseline (no steering, alpha=0.0) ---\\n{baseline}\\n\")\n",
        "      print(f\"--- Steered (alpha={alpha}) ---\\n{steered}\\n\")\n",
        "      return baseline, steered\n",
        "\n",
        "  def _layer_alpha_to_filename(layer_index: int, alpha: float) -> str:\n",
        "      alpha_tag = str(alpha).replace(\".\", \"p\")\n",
        "      return f\"steering_layer_{layer_index}_alpha_{alpha_tag}.csv\"\n",
        "\n",
        "  # --- Build direction and run generation ---\n",
        "  df_direction = pd.read_csv(DIRECTION_CSV_PATH)\n",
        "  df_test = pd.read_csv(TEST_CSV_PATH)\n",
        "  required_cols = {TEXT_COL, REFRAME_COL}\n",
        "  missing_direction = required_cols.difference(df_direction.columns)\n",
        "  missing_test = {TEXT_COL}.difference(df_test.columns)\n",
        "  if missing_direction:\n",
        "      raise ValueError(f\"Direction CSV must contain columns: {sorted(required_cols)}; missing={sorted(missing_direction)}\")\n",
        "  if missing_test:\n",
        "      raise ValueError(f\"Test CSV must contain columns: {sorted(missing_test)}; missing={sorted(missing_test)}\")\n",
        "\n",
        "  OUTPUT_DIR = OUTPUT_JSONL_PATH\n",
        "  os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "  # Precompute one steering direction per layer.\n",
        "  direction_by_layer = {}\n",
        "  for layer_index in tqdm(LAYER_LIST, desc=\"Direction\"):\n",
        "      if RANDOM_DIRECTION:\n",
        "          torch.manual_seed(RANDOM_SEED + layer_index)\n",
        "          direction = torch.randn(model.config.hidden_size)\n",
        "          direction = direction / (direction.norm() + 1e-8)\n",
        "          instruction_len = len(tokenizer(instruction_only_text(), add_special_tokens=False).input_ids)\n",
        "      else:\n",
        "          direction, instruction_len = compute_steering_direction(\n",
        "              df_direction,\n",
        "              tokenizer,\n",
        "              model,\n",
        "              layer_index,\n",
        "              TOKEN_RULE,\n",
        "              batch_size=BATCH_SIZE,\n",
        "              max_tokens=MAX_PROMPT_TOKENS,\n",
        "          )\n",
        "      direction_by_layer[layer_index] = (direction, instruction_len)\n",
        "\n",
        "  # Prepare buffers for every condition file.\n",
        "  outputs_by_condition = {}\n",
        "  for layer_index in LAYER_LIST:\n",
        "      for alpha in ALPHA_LIST:\n",
        "          output_col = f\"therapy_output_layer_{layer_index}_alpha_{alpha}\"\n",
        "          outputs_by_condition[(layer_index, alpha)] = {\n",
        "              \"output_col\": output_col,\n",
        "              \"rows\": [],\n",
        "          }\n",
        "\n",
        "  # Run prompt prefill once per row, then reuse cache across all layer/alpha decode runs.\n",
        "  for _, row in tqdm(df_test.iterrows(), total=len(df_test), desc=\"Rows\"):\n",
        "      text = row[TEXT_COL]\n",
        "      prompt_cache = prepare_prompt_cache(model, tokenizer, text)\n",
        "\n",
        "      for layer_index in LAYER_LIST:\n",
        "          direction, instruction_len = direction_by_layer[layer_index]\n",
        "          for alpha in ALPHA_LIST:\n",
        "              condition_key = (layer_index, alpha)\n",
        "              output_col = outputs_by_condition[condition_key][\"output_col\"]\n",
        "              response = generate_with_steering_from_cache(\n",
        "                  model,\n",
        "                  tokenizer,\n",
        "                  prompt_cache,\n",
        "                  direction,\n",
        "                  alpha,\n",
        "                  layer_index,\n",
        "                  instruction_len,\n",
        "                  max_new_tokens=MAX_NEW_TOKENS,\n",
        "                  temperature=TEMPERATURE,\n",
        "                  do_sample=DO_SAMPLE,\n",
        "              )\n",
        "              outputs_by_condition[condition_key][\"rows\"].append({\n",
        "                  TEXT_COL: text,\n",
        "                  output_col: response,\n",
        "              })\n",
        "\n",
        "  # Save one CSV per layer/alpha condition (same naming as before).\n",
        "  for (layer_index, alpha), payload in outputs_by_condition.items():\n",
        "      output_path = os.path.join(OUTPUT_DIR, _layer_alpha_to_filename(layer_index, alpha))\n",
